{
  "name": "jojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "XDG_CONFIG_HOME=/tmp/jojo-wrangler wrangler dev worker/src/index.ts --local --ip 127.0.0.1 --port 8788",
    "worker:deploy": "wrangler deploy",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.91.0"
  }
}
